{
    "name": "@gopay-internal/core",
    "private": true,
    "version": "0.0.0",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "typesVersions": {
        "*": {
            "types/generated.js": [
                "./dist/types/generated.d.ts"
            ],
            "types/generated": [
                "./dist/types/generated.d.ts"
            ]
        }
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./types/generated.js": {
            "types": "./dist/types/generated.d.ts",
            "import": "./dist/types/generated.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "codegen": "node scripts/codegen.mjs"
    },
    "devDependencies": {
        "@types/node": "^24.12.2",
        "openapi-typescript": "^7.13.0",
        "tsup": "^8.5.1",
        "typescript": "~6.0.3"
    }
}
